# --- Vercel project env vars (Settings → Environment Variables) ---

# SERVER-SIDE ONLY (never prefix with VITE_): enables real IPFS pinning for photos + metadata.
# Create a Pinata API key limited to pinFileToIPFS + pinJSONToIPFS and paste the JWT.
# Without it the app still works: metadata is stored on-chain as a data: URI (photo hash only, no photo).
PINATA_JWT=

# Optional: public IPFS gateway used to display photos (default https://gateway.pinata.cloud/ipfs/)
VITE_IPFS_GATEWAY=

# Optional: enables the WalletConnect option (phones without an injected wallet). Free at cloud.reown.com
VITE_WC_PROJECT_ID=

# Optional: contract addresses as one-line JSON (same shape as src/generated/deployment.json).
# Lets you go live by setting an env var + redeploy, with no git commit.
VITE_DEPLOYMENT_JSON=

# Local development against `anvil`: set to "local"
VITE_CHAIN=
